{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "config-exporter (docker-compose)",
            "type": "shell",
            "command": "docker compose --env-file .env.dev up --force-recreate",
            "options": {
                "cwd": "${workspaceFolder}/stack/config-exporter"
            },
            "problemMatcher": []
        },
        {
            "label": "OpenAPI: platform management",
            "type": "process",
            "command": "mvn",
            "args": ["-pl", "platform_management/platform_management.service/platform_management.service.app", "-am", "-Dtest=org.eclipse.slm.platform_management.service.app.OpenApiSpecGenerationTest", "-Dsurefire.failIfNoSpecifiedTests=false", "-DgenerateOpenApiSpec=true", "test"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
